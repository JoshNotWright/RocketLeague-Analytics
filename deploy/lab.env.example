# /etc/rlreplay/lab.env on the lab (root:rlreplay, mode 640). The lab is the control plane: every
# secret lives here and nowhere else. Copy this file, fill it in, never commit the filled copy.

# --- secrets --------------------------------------------------------------------------------------
HCLOUD_TOKEN=                 # Hetzner Cloud API token for the project the crawler servers live in
BALLCHASING_API_KEY=          # ballchasing.com key (GC tier); piped to the box over SSH at boot
TS_AUTHKEY=                   # Tailscale auth key: ephemeral, pre-authorised, reusable, tagged tag:rl-crawler

# --- lab -------------------------------------------------------------------------------------------
LAB_ROOT=/tank/rl             # the data tree: decoded/, meta/, batches/, boxes/
LAB_USER=rlreplay             # the user the box pushes as (SFTP + the validate trigger); created by lab_setup.sh
LAB_TS_HOST=lab               # the lab's tailnet name or 100.x address, as seen from the box
LAB_REPO=/opt/rlreplay        # this repository on the lab (scripts/lab_validate.py, the UI)
CRAWLER_KEY=/etc/rlreplay/crawler_key   # private key the box uses to reach LAB_USER@LAB_TS_HOST (lab_setup.sh makes it)
HCLOUD_SSH_KEY=rl-lab         # name of the lab's public key in Hetzner (hcloud ssh-key); root@box accepts it

# --- crawler defaults (crawler_up.sh arguments override) ---------------------------------------------
CRAWLER_NAME=rl-crawler       # server and tailnet hostname
CRAWLER_TYPE=cpx32            # 4 vCPU, 8 GB, 160 GB NVMe; cpx22 (80 GB) with CRAWLER_BATCH=10000 if cost matters more
CRAWLER_LOCATION=fsn1         # Falkenstein; nbg1 and hel1 are the other EU locations
CRAWLER_BATCH=20000           # replays per pushed batch (about 22 GB raw + 6 GB decoded on the box)
CRAWLER_WORKERS=4
CRAWLER_PLAYLIST=ranked-doubles
CRAWLER_BANDS=diamond:diamond-1:diamond-3,champion:champion-1:champion-3,gc:grand-champion-1:grand-champion-3
CRAWLER_MONTHS=2025-07..2026-10   # inclusive; one crawl window per band per month
CRAWLER_PER_WINDOW=               # cap on replays per window; empty = everything ballchasing lists

# --- web UI ---------------------------------------------------------------------------------------------
LAB_UI_BIND=100.64.0.1        # tailnet address the UI listens on (never 0.0.0.0 on a routable interface)
LAB_UI_PORT=8731
